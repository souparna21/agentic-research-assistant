# Agentic Research Assistant — example environment
# Copy to .env and fill in real values. .env is .gitignored.
# See README §Setup for how to obtain a free Gemini API key.

# --- LLM provider (default: Gemini 2.5 Flash free tier) ---
ARA_LLM_MODEL=gemini/gemini-2.5-flash
ARA_LLM_TEMPERATURE=0.0
ARA_LLM_MAX_TOKENS=2048

# --- API keys (only the one matching ARA_LLM_MODEL is required) ---
# Get a free Gemini key at https://aistudio.google.com/apikey
ARA_GEMINI_API_KEY=your_key_here
# Optional: swap to OpenAI by setting ARA_LLM_MODEL=openai/gpt-4o-mini
ARA_OPENAI_API_KEY=

# --- Paths ---
ARA_RUNS_DIR=runs
ARA_PROMPTS_DIR=prompts

# --- Logging ---
ARA_LOG_LEVEL=INFO
